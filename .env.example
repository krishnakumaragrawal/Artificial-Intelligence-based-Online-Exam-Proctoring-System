APP_NAME=AI Exam Proctoring Platform
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://proctoring:proctoring@postgres:5432/proctoring
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
